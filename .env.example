# FortyGuard Temperature API (header name is api-key, not Bearer)
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_MAX_AOI_MI2=10
# Keep false until you explicitly authorize live credit spend
FORTYGUARD_LIVE=false

# LLM providers — chain: primary provider first, then the other as fallback.
# "groq" is primary: JSON mode, ~1s latency, free plan 30 RPM / 1K req/day (console.groq.com/keys).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=qwen/qwen3.6-27b

# OpenRouter fallback — free-tier slugs only (must end with :free, enforced).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,minimax/minimax-m2.7:free

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fortyguard-aegis
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_EVAL_PROJECT=fortyguard-aegis-eval

AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_POLL_TIMEOUT_SECONDS=180
AEGIS_MAX_RETRIES=3
AEGIS_LLM_MODE=auto
# false = deterministic template memo (recommended: cited numbers stay exact, ~2s runs)
# true  = LLM-polished memo (slower, can paraphrase citations)
AEGIS_SYNTH_LLM=false

# Frontend (copy this into frontend/.env.local for the Next.js app)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
