{
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/.next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/brief",
      "destination": "/api/index.py"
    },
    {
      "source": "/status/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/report/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    }
  ]
}
