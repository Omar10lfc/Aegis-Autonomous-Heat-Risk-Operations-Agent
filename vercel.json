{
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/.next",
  "rewrites": [
    {
      "source": "/brief",
      "destination": "/api/index.py"
    },
    {
      "source": "/status/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/report/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    }
  ]
}
